<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">NEATWorldPay Virtual Terminal Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group invisible="code != 'neatworldpayvt'">
<div class="alert alert-success" role="alert" colspan="2" invisible="neatworldpayvt_activation_code">
                        Don't have an Activation Code yet?<br />
                          
                        
                    <a href="https://api.sns-software.com/license-request?provider=worldpay" target="_blank" rel="noopener noreferrer">
                        Get a free activation code
                    </a>
                </div>
                <field
                        name="neatworldpayvt_reset_code"
                        string="Update Module Cache"
                        required="code == 'neatworldpayvt' and state != 'disabled'"
                    />
                    <field
                        name="neatworldpayvt_activation_code"
                        string="Activation Code"
                        password="True"
                        required="code == 'neatworldpayvt' and state != 'disabled'"
                    />
                    <field
                        name="neatworldpayvt_username"
                        string="Username"
                        required="code == 'neatworldpayvt' and state != 'disabled'"
                    />
                    <field
                        name="neatworldpayvt_password"
                        string="Password"
                        password="True"
                        required="code == 'neatworldpayvt' and state != 'disabled'"
                    />
                    <field
                        name="neatworldpayvt_checkout_id"
                        string="Checkout ID"
                        required="code == 'neatworldpayvt' and state != 'disabled'"
                    />
                    <field
                        name="neatworldpayvt_entity"
                        string="Entity"
                        required="code == 'neatworldpayvt' and state != 'disabled'"
                    />
                    <field
                        name="neatworldpayvt_fallback_user_id"
                        string="Fallback Failure VT User"
                        required="code == 'neatworldpayvt' and state != 'disabled'"
                    />
                    <div class="alert alert-success" role="alert" colspan="2">
                        <b>By using this module you agree to our </b>
                        
                    <a href="https://api.sns-software.com/terms?provider=worldpay" target="_blank" rel="noopener noreferrer">
                        terms and conditions
                    </a>
                </div>
                    <div class="oe_structure" colspan="2">
                        <p>
                            Please make sure to set the following webhook in the Worldpay Dashboard:
                        </p>
                        <p><strong>{Odoo Server URL}/neatworldpayvt/wh</strong></p>
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
